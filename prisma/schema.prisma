generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auto_message {
  id         Int      @id @default(autoincrement())
  guild_id   String   @db.VarChar(22)
  message    String   @db.Text
  channel    String   @db.VarChar(22)
  time       String   @db.VarChar(5)
  days       Json
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model birthday_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  message    String   @db.Text
  time       String   @db.VarChar(5)
  enabled    Boolean
  created_at DateTime @default(now())
}

model birthday {
  id         Int      @id @default(autoincrement())
  guild_id   String   @db.VarChar(22)
  user_id    String   @db.VarChar(22)
  birth_date DateTime @db.Date
  created_at DateTime @default(now())
}

model bot_settings {
  id                 Int      @id @default(autoincrement())
  guild_id           String   @unique
  nickname           String?  @db.VarChar(50)
  language           String?  @db.VarChar(3)
  updates_channel    String?  @db.VarChar(22)
  timezone           String?  @db.VarChar(22)
  primary_color      String?  @db.VarChar(22)
  secondary_color    String?  @db.VarChar(22)
  created_at         DateTime @default(now())
  show_in_guild_list Boolean  @default(true)
}

model bump_reminder_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  message    String   @db.Text
  interval   Int
  enabled    Int      @default(1)
  created_at DateTime @default(now())
}

model migration {
  id    Int      @id @default(autoincrement())
  name  String   @db.Text
  runat DateTime @default(now())
}

model premium_guild {
  id            Int       @id @default(autoincrement())
  guild_id      String    @unique
  premium       Boolean   @default(false)
  trial_ends_at DateTime?
  created_at    DateTime  @default(now())
}

model user_action {
  id         Int      @id @default(autoincrement())
  guild_id   String
  user_id    String
  action     String
  created_at DateTime @default(now())
}

model welcome_message_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  messages   Json?
  channel    String?  @db.VarChar(22)
  enabled    Int
  randomize  Boolean  @default(false)
  created_at DateTime @default(now())
}

model leave_message_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  messages   Json?
  channel    String?  @db.VarChar(22)
  enabled    Int
  randomize  Boolean  @default(false)
  created_at DateTime @default(now())
}

model ticket_settings {
  id           Int      @id @default(autoincrement())
  guild_id     String   @unique
  channel      String?  @db.VarChar(22)
  channel_conf String?  @db.VarChar(22)
  enabled      Int
  created_at   DateTime @default(now())
}

model bot_log {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  timestamp DateTime @default(now())
}

model dashboard_log {
  id        Int      @id @default(autoincrement())
  guild_id  String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guild_id])
}

model guild_log {
  id        Int      @id @default(autoincrement())
  guild_id  String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guild_id])
}

model kickwatcher {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  users      Json
  enabled    Boolean
  created_at DateTime @default(now())
}

model twitch_watcher {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  users      Json
  enabled    Boolean
  created_at DateTime @default(now())
}

model youtube_watcher {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  users      Json
  enabled    Boolean
  created_at DateTime @default(now())
}

model anti_bot_settings {
  id                   Int      @id @default(autoincrement())
  guild_id             String   @unique
  enabled              Boolean  @default(false)
  time_window          Int      @default(10)
  channel_limit        Int      @default(3)
  punishment           String   @default("none") @db.VarChar(20)
  forbidden_words      Json?
  notification_channel String?  @db.VarChar(22)
  jailrole             String?  @db.VarChar(22)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  block_invites        Boolean  @default(false)
  exclude_admins       Boolean  @default(false)
}

model channel_of_fame {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String?  @db.VarChar(22)
  emoji      String?  @db.VarChar(10)
  amount     Int      @default(0)
  enabled    Boolean  @default(false)
  created_at DateTime @default(now())
}

model leveling_settings {
  id                   Int      @id @default(autoincrement())
  guild_id             String   @unique
  channel              String?  @db.VarChar(22)
  level_roles          Json?
  xp_rate              Float    @default(200)
  enabled              Boolean  @default(false)
  created_at           DateTime @default(now())
  curve_exponent       Float    @default(2.65)
  xp_message_gainspeed String   @default("oneTimeAMinute")
  xp_per_message       Int      @default(10)
  xp_pervoice          Int      @default(5)
  xp_voice_gainspeed   String   @default("everyMinute")
}

model logging_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String?  @db.VarChar(22)
  events     Json?
  enabled    Boolean  @default(false)
  created_at DateTime @default(now())
}

model giveaway_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String?  @db.VarChar(22)
  enabled    Boolean  @default(false)
  created_at DateTime @default(now())
}

model introduction_settings {
  guild_id     String   @id
  enabled      Boolean  @default(false)
  channel      String?
  max_messages Int      @default(1)
  auto_reply   String?
  auto_emoji   String?
  auto_delete  Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model minecraft_settings {
  guild_id       String   @id
  enabled        Boolean  @default(false)
  ip             String
  port           Int      @default(25565)
  notify_enabled Boolean  @default(false)
  channel        String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model guild_invite_settings {
  id         Int                     @id @default(autoincrement())
  guild_id   String                  @unique
  enabled    Boolean                 @default(false)
  created_at DateTime                @default(now())
  invites    invite_tracker_invite[]
}

model invite_tracker_invite {
  id          Int                   @id @default(autoincrement())
  guild_id    String
  invite_code String                @unique
  invite_type String?
  created_at  DateTime              @default(now())
  guild       guild_invite_settings @relation(fields: [guild_id], references: [guild_id], onDelete: Cascade)

  @@index([guild_id])
}

model auto_role_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  auto_roles Json?
  enabled    Boolean  @default(false)
  created_at DateTime @default(now())
}

model picture_contest_settings {
  id         Int                    @id @default(autoincrement())
  guild_id   String                 @unique
  created_at DateTime               @default(now())
  contests   picture_contest_item[]
}

model picture_contest_item {
  id               Int                      @id @default(autoincrement())
  guild_id         String
  name             String                   @default("New Contest")
  contest_channel  String
  announce_channel String
  vote_emoji       String                   @default("?")
  vote_type        String                   @default("highest")
  required_votes   Int?
  schedule         String                   @default("end_month")
  enabled          Boolean                  @default(true)
  created_at       DateTime                 @default(now())
  guild            picture_contest_settings @relation(fields: [guild_id], references: [guild_id], onDelete: Cascade)

  @@index([guild_id])
}

model leveling_data {
  id         Int      @id @default(autoincrement())
  guild_id   String
  user_id    String
  xp         Int      @default(0)
  level      Int      @default(0)
  updated_at DateTime

  @@unique([guild_id, user_id])
}

model giveaway {
  id           Int                    @id @default(autoincrement())
  guild_id     String
  ends_at      DateTime
  winners      Int
  prize        String
  extra_rules  String
  active       Boolean                @default(true)
  message_id   String?
  created_at   DateTime               @default(now())
  participants giveaway_participant[]

  @@index([guild_id])
}

model giveaway_participant {
  giveaway_id Int
  user_id     String
  winner      Boolean  @default(false)
  giveaway    giveaway @relation(fields: [giveaway_id], references: [id])

  @@id([giveaway_id, user_id])
}

model account {
  id                  String  @id @default(cuid())
  user_id             String
  type                String
  provider            String
  provider_account_id String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                user    @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_account_id])
  @@index([user_id])
}

model session {
  id            String   @id @default(cuid())
  session_token String   @unique
  user_id       String
  expires       DateTime
  user          user     @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model verification_token {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  email_verified DateTime?
  image          String?
  accounts       account[]
  sessions       session[]
}

model streak_settings {
  id       Int     @id @default(autoincrement())
  guild_id String  @unique
  channel  String  @db.VarChar(22)
  role     String? @db.VarChar(22)
  enabled  Boolean
}

model streak {
  id          Int      @id @default(autoincrement())
  user_id     String   @unique
  streak      Int
  last_active DateTime
}

model boost_spotlight_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  messages   Json?
  channel    String?  @db.VarChar(22)
  enabled    Boolean
  randomize  Boolean  @default(true)
  created_at DateTime @default(now())
}

model time_keeper_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  enabled    Boolean
  created_at DateTime @default(now())
}

model reminder {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.VarChar(32)
  guild_id   String?  @db.VarChar(32)
  channel_id String   @db.VarChar(32)
  message    String
  remind_at  DateTime
  created_at DateTime @default(now())
  is_active  Boolean  @default(true)
}

model server_anniversary_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  messages   Json?
  channel    String?  @db.VarChar(22)
  time       String   @db.VarChar(5)
  enabled    Boolean
  randomize  Boolean  @default(true)
  created_at DateTime @default(now())
}

model message_glue {
  id         Int      @id @default(autoincrement())
  guild_id   String   @db.VarChar(22)
  message    String   @db.Text
  channel    String   @db.VarChar(22)
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model server_backup_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  channel    String   @db.VarChar(22)
  enabled    Boolean  @default(false)
  frequency  String   @db.VarChar(10)
  time       String   @db.VarChar(5)
  content    Json?
  created_at DateTime @default(now())

  backups server_backups[]
}

model server_backups {
  id         Int      @id @default(autoincrement())
  guild_id   String   @db.VarChar(22)
  backup     Json
  created_at DateTime @default(now())

  guild server_backup_settings @relation(fields: [guild_id], references: [guild_id])
}

model message_report_settings {
  id         Int      @id @default(autoincrement())
  guild_id   String   @unique
  enabled    Boolean  @default(false)
  channel    String   @db.VarChar(22)
  created_at DateTime @default(now())
}

model message_reports {
  id         Int      @id @default(autoincrement())
  guild_id   String
  user_id    String   @db.VarChar(22)
  message    String   @db.Text
  created_at DateTime @default(now())

  @@index([guild_id])
  @@index([guild_id, user_id])
}
