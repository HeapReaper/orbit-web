generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutoMessage {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(22)
  message   String   @db.Text
  channel   String   @db.VarChar(22)
  time      String   @db.VarChar(5)
  days      Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model BirthdaySettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "BirthdaySettings_guildId")
  channel   String   @db.VarChar(22)
  message   String   @db.Text
  time      String   @db.VarChar(5)
  enabled   Boolean
  createdAt DateTime @default(now())
}

model Birthday {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(22)
  userId    String   @db.VarChar(22)
  birthdate DateTime @db.Date
  createdAt DateTime @default(now())
}

model BotSettings {
  id              Int      @id @default(autoincrement())
  guildId         String   @unique(map: "BotSettings_guildId")
  nickname        String?  @db.VarChar(50)
  language        String?  @db.VarChar(3)
  updatesChannel  String?  @db.VarChar(22)
  timezone        String?  @db.VarChar(22)
  primaryColor    String?  @db.VarChar(22)
  secondaryColor  String?  @db.VarChar(22)
  createdAt       DateTime @default(now())
  showInGuildList Boolean  @default(true)
}

model BumpReminderSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "BumpReminderSettings_guildId")
  channel   String   @db.VarChar(22)
  message   String   @db.Text
  interval  Int
  enabled   Int      @default(1)
  createdAt DateTime @default(now())
}

model Migration {
  id    Int      @id @default(autoincrement())
  name  String   @db.Text
  runAt DateTime @default(now())
}

model PremiumGuild {
  id          Int       @id @default(autoincrement())
  guildId     String    @unique(map: "PremiumGuild_guildId")
  premium     Boolean   @default(false)
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
}

model UserAction {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  action    String
  createdAt DateTime @default(now())
}

model WelcomeMessageSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "WelcomeMessageSettings_guildId")
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Int
  randomize Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LeaveMessageSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "LeaveMessageSettings_guildId")
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Int
  randomize Boolean  @default(false)
  createdAt DateTime @default(now())
}

model TicketSettings {
  id          Int      @id @default(autoincrement())
  guildId     String   @unique(map: "TicketSettings_guildId")
  channel     String?  @db.VarChar(22)
  channelConf String?  @db.VarChar(22)
  enabled     Int
  createdAt   DateTime @default(now())
}

model BotLog {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  timestamp DateTime @default(now())
}

model DashboardLog {
  id        Int      @id @default(autoincrement())
  guildId   String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guildId])
}

model GuildLog {
  id        Int      @id @default(autoincrement())
  guildId   String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guildId])
}

model KickWatcher {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "KickWatcher_guildId")
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdAt DateTime @default(now())
}

model TwitchWatcher {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "TwitchWatcher_guildId")
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdAt DateTime @default(now())
}

model YoutubeWatcher {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "YoutubeWatcher_guildId")
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdAt DateTime @default(now())
}

model AntiBotSettings {
  id                  Int      @id @default(autoincrement())
  guildId             String   @unique(map: "AntiBotSettings_guildId")
  enabled             Boolean  @default(false)
  timeWindow          Int      @default(10)
  channelLimit        Int      @default(3)
  punishment          String   @default("none") @db.VarChar(20)
  forbiddenWords      Json?
  notificationChannel String?  @db.VarChar(22)
  jailRole            String?  @db.VarChar(22)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  blockInvites        Boolean  @default(false)
  excludeAdmins       Boolean  @default(false)
}

model ChannelOfFame {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "ChannelOfFame_guildId")
  channel   String?  @db.VarChar(22)
  emoji     String?  @db.VarChar(10)
  amount    Int      @default(0)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LevelingSettings {
  id                 Int      @id @default(autoincrement())
  guildId            String   @unique(map: "LevelingSettings_guildId")
  channel            String?  @db.VarChar(22)
  levelRoles         Json?
  xpRate             Float    @default(200)
  enabled            Boolean  @default(false)
  createdAt          DateTime @default(now())
  curveExponent      Float    @default(2.65)
  xpMessageGainSpeed String   @default("oneTimeAMinute")
  xpPerMessage       Int      @default(10)
  xpPerVoice         Int      @default(5)
  xpVoiceGainSpeed   String   @default("everyMinute")
}

model LoggingSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "LoggingSettings_guildId")
  channel   String?  @db.VarChar(22)
  events    Json?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GiveawaySettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "GiveawaySettings_guildId")
  channel   String?  @db.VarChar(22)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model IntroductionSettings {
  guildId     String   @id
  enabled     Boolean  @default(false)
  channel     String?
  maxMessages Int      @default(1)
  autoReply   String?
  autoEmoji   String?
  autoDelete  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MinecraftSettings {
  guildId       String   @id
  enabled       Boolean  @default(false)
  ip            String
  port          Int      @default(25565)
  notifyEnabled Boolean  @default(false)
  channel       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GuildInviteSettings {
  id        Int                   @id @default(autoincrement())
  guildId   String                @unique(map: "GuildInviteSettings_guildId")
  enabled   Boolean               @default(false)
  createdAt DateTime              @default(now())
  invites   InviteTrackerInvite[]
}

model InviteTrackerInvite {
  id         Int                 @id @default(autoincrement())
  guildId    String
  inviteCode String              @unique
  inviteType String?
  createdAt  DateTime            @default(now())
  guild      GuildInviteSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model AutoRoleSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "AutoRoleSettings_guildId")
  autoRoles Json?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PictureContestSettings {
  id        Int                  @id @default(autoincrement())
  guildId   String               @unique(map: "PictureContestSettings_guildId")
  createdAt DateTime             @default(now())
  contests  PictureContestItem[]
}

model PictureContestItem {
  id              Int                    @id @default(autoincrement())
  guildId         String
  name            String                 @default("New Contest")
  contestChannel  String
  announceChannel String
  voteEmoji       String                 @default("?")
  voteType        String                 @default("highest")
  requiredVotes   Int?
  schedule        String                 @default("end_month")
  enabled         Boolean                @default(true)
  createdAt       DateTime               @default(now())
  guild           PictureContestSettings @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
}

model LevelingData {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String
  xp        Int      @default(0)
  level     Int      @default(0)
  updatedAt DateTime

  @@unique([guildId, userId])
}

model Giveaway {
  id           Int                   @id @default(autoincrement())
  guildId      String
  endsAt       DateTime
  winners      Int
  prize        String
  extraRules   String
  active       Boolean               @default(true)
  messageId    String?
  createdAt    DateTime              @default(now())
  participants GiveawayParticipant[]

  @@index([guildId])
  @@map("giveaways")
}

model GiveawayParticipant {
  giveawayId Int
  userId     String
  winner     Boolean  @default(false)
  Giveaway   Giveaway @relation(fields: [giveawayId], references: [id])

  @@id([giveawayId, userId])
  @@map("giveaway_participants")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model StreakSettings {
  id      Int     @id @default(autoincrement())
  guildId String  @unique(map: "StreakSettings_guildId")
  channel String  @db.VarChar(22)
  role    String? @db.VarChar(22)
  enabled Boolean
}

model Streak {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  streak     Int
  lastActive DateTime
}

model BoostSpotlightSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "BoostSpotlightSettings_guildId")
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Boolean
  randomize Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TimeKeeperSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "TimeKeeperSettings_guildId")
  enabled   Boolean
  createdAt DateTime @default(now())
}

model Reminder {
  id        Int      @id @default(autoincrement())
  userId    String   @db.VarChar(32)
  guildId   String?  @db.VarChar(32)
  channelId String   @db.VarChar(32)
  message   String
  remindAt  DateTime
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
}

model ServerAnniversarySettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "ServerAnniversarySettings_guildId")
  messages  Json?
  channel   String?  @db.VarChar(22)
  time      String   @db.VarChar(5)
  enabled   Boolean
  randomize Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MessageGlue {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(22)
  message   String   @db.Text
  channel   String   @db.VarChar(22)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model ServerBackupSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "ServerBackupSettings_guildId")
  channel   String   @db.VarChar(22)
  enabled   Boolean  @default(false)
  frequency String   @db.VarChar(10)
  time      String   @db.VarChar(5)
  content   Json?
  createdAt DateTime @default(now())

  backups ServerBackups[]
}

model ServerBackups {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(22)
  backup    Json
  createdAt DateTime @default(now())

  guild ServerBackupSettings @relation(fields: [guildId], references: [guildId])
}

model MessageReportSettings {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique(map: "MessageReportSettings_guildId")
  enabled   Boolean  @default(false)
  channel   String   @db.VarChar(22)
  createdAt DateTime @default(now())
}

model MessageReports {
  id        Int      @id @default(autoincrement())
  guildId   String
  userId    String   @db.VarChar(22)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([guildId])
  @@index([guildId, userId])
}
