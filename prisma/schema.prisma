generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model automessage {
  id        Int      @id @default(autoincrement())
  guildid   String   @db.VarChar(22)
  message   String   @db.Text
  channel   String   @db.VarChar(22)
  time      String   @db.VarChar(5)
  days      Json
  enabled   Boolean  @default(true)
  createdat DateTime @default(now())
  updatedat DateTime @default(now())
}

model birthsettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  message   String   @db.Text
  time      String   @db.VarChar(5)
  enabled   Boolean
  createdat DateTime @default(now())
}

model birthday {
  id        Int      @id @default(autoincrement())
  guildid   String   @db.VarChar(22)
  userid    String   @db.VarChar(22)
  birthdate DateTime @db.Date
  createdat DateTime @default(now())
}

model botsettings {
  id              Int      @id @default(autoincrement())
  guildid         String   @unique
  nickname        String?  @db.VarChar(50)
  language        String?  @db.VarChar(3)
  updateschannel  String?  @db.VarChar(22)
  timezone        String?  @db.VarChar(22)
  primarycolor    String?  @db.VarChar(22)
  secondarycolor  String?  @db.VarChar(22)
  createdat       DateTime @default(now())
  showinguildlist Boolean  @default(true)
}

model bumpremindersettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  message   String   @db.Text
  interval  Int
  enabled   Int      @default(1)
  createdat DateTime @default(now())
}

model migration {
  id    Int      @id @default(autoincrement())
  name  String   @db.Text
  runat DateTime @default(now())
}

model premiumguild {
  id          Int       @id @default(autoincrement())
  guildid     String    @unique
  premium     Boolean   @default(false)
  trialendsat DateTime?
  createdat   DateTime  @default(now())
}

model useraction {
  id        Int      @id @default(autoincrement())
  guildid   String
  userid    String
  action    String
  createdat DateTime @default(now())
}

model welcomemessagesettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Int
  randomize Boolean  @default(false)
  createdat DateTime @default(now())
}

model leavemessagesettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Int
  randomize Boolean  @default(false)
  createdat DateTime @default(now())
}

model ticketsettings {
  id          Int      @id @default(autoincrement())
  guildid     String   @unique
  channel     String?  @db.VarChar(22)
  channelconf String?  @db.VarChar(22)
  enabled     Int
  createdat   DateTime @default(now())
}

model botlog {
  id        Int      @id @default(autoincrement())
  type      String
  message   String
  timestamp DateTime @default(now())
}

model dashboardlog {
  id        Int      @id @default(autoincrement())
  guildid   String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guildid])
}

model guildlog {
  id        Int      @id @default(autoincrement())
  guildid   String
  type      String
  message   String
  timestamp DateTime @default(now())

  @@index([guildid])
}

model kickwatcher {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdat DateTime @default(now())
}

model twitchwatcher {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdat DateTime @default(now())
}

model youtubewatcher {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  users     Json
  enabled   Boolean
  createdat DateTime @default(now())
}

model antibotsettings {
  id                  Int      @id @default(autoincrement())
  guildid             String   @unique
  enabled             Boolean  @default(false)
  timewindow          Int      @default(10)
  channellimit        Int      @default(3)
  punishment          String   @default("none") @db.VarChar(20)
  forbiddenwords      Json?
  notificationchannel String?  @db.VarChar(22)
  jailrole            String?  @db.VarChar(22)
  createdat           DateTime @default(now())
  updatedat           DateTime @updatedAt
  blockinvites        Boolean  @default(false)
  excludeadmins       Boolean  @default(false)
}

model channeloffame {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String?  @db.VarChar(22)
  emoji     String?  @db.VarChar(10)
  amount    Int      @default(0)
  enabled   Boolean  @default(false)
  createdat DateTime @default(now())
}

model levelingsettings {
  id                 Int      @id @default(autoincrement())
  guildid            String   @unique
  channel            String?  @db.VarChar(22)
  levelroles         Json?
  xprate             Float    @default(200)
  enabled            Boolean  @default(false)
  createdat          DateTime @default(now())
  curveexponent      Float    @default(2.65)
  xpmessagegainspeed String   @default("oneTimeAMinute")
  xppermessage       Int      @default(10)
  xppervoice         Int      @default(5)
  xpvoicegainspeed   String   @default("everyMinute")
}

model loggingsettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String?  @db.VarChar(22)
  events    Json?
  enabled   Boolean  @default(false)
  createdat DateTime @default(now())
}

model giveawaysettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String?  @db.VarChar(22)
  enabled   Boolean  @default(false)
  createdat DateTime @default(now())
}

model introductionsettings {
  guildid     String   @id
  enabled     Boolean  @default(false)
  channel     String?
  maxmessages Int      @default(1)
  autoreply   String?
  autoemoji   String?
  autodelete  Boolean  @default(false)
  createdat   DateTime @default(now())
  updatedat   DateTime @updatedAt
}

model minecraftsettings {
  guildid       String   @id
  enabled       Boolean  @default(false)
  ip            String
  port          Int      @default(25565)
  notifyenabled Boolean  @default(false)
  channel       String?
  createdat     DateTime @default(now())
  updatedat     DateTime @updatedAt
}

model guildinvitesettings {
  id        Int                   @id @default(autoincrement())
  guildid   String                @unique
  enabled   Boolean               @default(false)
  createdat DateTime              @default(now())
  invites   inviteTrackerInvite[]
}

model inviteTrackerInvite {
  id         Int                 @id @default(autoincrement())
  guildid    String
  invitecode String              @unique
  invitetype String?
  createdat  DateTime            @default(now())
  guild      guildinvitesettings @relation(fields: [guildid], references: [guildid], onDelete: Cascade)

  @@index([guildid])
}

model autorolesettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  autoroles Json?
  enabled   Boolean  @default(false)
  createdat DateTime @default(now())
}

model picturecontestsettings {
  id        Int                  @id @default(autoincrement())
  guildid   String               @unique
  createdat DateTime             @default(now())
  contests  picturecontestitem[]
}

model picturecontestitem {
  id              Int                    @id @default(autoincrement())
  guildid         String
  name            String                 @default("New Contest")
  contestchannel  String
  announcechannel String
  voteemoji       String                 @default("?")
  votetype        String                 @default("highest")
  requiredvotes   Int?
  schedule        String                 @default("end_month")
  enabled         Boolean                @default(true)
  createdat       DateTime               @default(now())
  guild           picturecontestsettings @relation(fields: [guildid], references: [guildid], onDelete: Cascade)

  @@index([guildid])
}

model levelingdata {
  id        Int      @id @default(autoincrement())
  guildid   String
  userid    String
  xp        Int      @default(0)
  level     Int      @default(0)
  updatedat DateTime

  @@unique([guildid, userid])
}

model giveaway {
  id           Int                   @id @default(autoincrement())
  guildid      String
  endsat       DateTime
  winners      Int
  prize        String
  extrarules   String
  active       Boolean               @default(true)
  messageid    String?
  createdat    DateTime              @default(now())
  participants giveawayparticipant[]

  @@index([guildid])
}

model giveawayparticipant {
  giveawayid Int
  userid     String
  winner     Boolean  @default(false)
  giveaway   giveaway @relation(fields: [giveawayid], references: [id])

  @@id([giveawayid, userid])
}

model account {
  id                String  @id @default(cuid())
  userid            String
  type              String
  provider          String
  provideraccountid String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userid], references: [id])

  @@unique([provider, provideraccountid])
  @@index([userid])
}

model session {
  id           String   @id @default(cuid())
  sessiontoken String   @unique
  userid       String
  expires      DateTime
  user         user     @relation(fields: [userid], references: [id])

  @@index([userid])
}

model verificationtoken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model user {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailverified DateTime?
  image         String?
  accounts      account[]
  sessions      session[]
}

model streaksettings {
  id      Int     @id @default(autoincrement())
  guildid String  @unique
  channel String  @db.VarChar(22)
  role    String? @db.VarChar(22)
  enabled Boolean
}

model streak {
  id         Int      @id @default(autoincrement())
  userid     String   @unique
  streak     Int
  lastactive DateTime
}

model boostspotlightsettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  messages  Json?
  channel   String?  @db.VarChar(22)
  enabled   Boolean
  randomize Boolean  @default(true)
  createdat DateTime @default(now())
}

model timekeepersettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  enabled   Boolean
  createdat DateTime @default(now())
}

model reminder {
  id        Int      @id @default(autoincrement())
  userid    String   @db.VarChar(32)
  guildid   String?  @db.VarChar(32)
  channelid String   @db.VarChar(32)
  message   String
  remindat  DateTime
  createdat DateTime @default(now())
  isactive  Boolean  @default(true)
}

model serveranniversarysettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  messages  Json?
  channel   String?  @db.VarChar(22)
  time      String   @db.VarChar(5)
  enabled   Boolean
  randomize Boolean  @default(true)
  createdat DateTime @default(now())
}

model messageglue {
  id        Int      @id @default(autoincrement())
  guildid   String   @db.VarChar(22)
  message   String   @db.Text
  channel   String   @db.VarChar(22)
  enabled   Boolean  @default(true)
  createdat DateTime @default(now())
  updatedat DateTime @default(now())
}

model serverbackupsettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  channel   String   @db.VarChar(22)
  enabled   Boolean  @default(false)
  frequency String   @db.VarChar(10)
  time      String   @db.VarChar(5)
  content   Json?
  createdat DateTime @default(now())

  backups serverbackups[]
}

model serverbackups {
  id        Int      @id @default(autoincrement())
  guildid   String   @db.VarChar(22)
  backup    Json
  createdat DateTime @default(now())

  guild serverbackupsettings @relation(fields: [guildid], references: [guildid])
}

model messagereportsettings {
  id        Int      @id @default(autoincrement())
  guildid   String   @unique
  enabled   Boolean  @default(false)
  channel   String   @db.VarChar(22)
  createdat DateTime @default(now())
}

model messagereports {
  id        Int      @id @default(autoincrement())
  guildid   String
  userid    String   @db.VarChar(22)
  message   String   @db.Text
  createdat DateTime @default(now())

  @@index([guildid])
  @@index([guildid, userid])
}
